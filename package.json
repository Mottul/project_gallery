{
  "name": "galeria-beata",
  "productName": "Galeria Beata",
  "version": "0.1.0",
  "private": true,
  "description": "Bild- und Videobetrachter mit Bildbearbeitung für Windows – offline, Bilddaten geschützt",
  "author": "Matthias",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/fetch-electron-bin.mjs && electron-vite dev",
    "start": "node scripts/fetch-electron-bin.mjs && electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/fetch-electron-bin.mjs && electron-vite build && node e2e/run.mjs",
    "e2e:run": "node scripts/fetch-electron-bin.mjs && node e2e/run.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:files": "node scripts/check-filenames.mjs",
    "check:refs": "node scripts/check-doc-refs.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "electron:bin": "node scripts/fetch-electron-bin.mjs",
    "exiftool:fetch": "node scripts/download-exiftool.mjs",
    "ffmpeg:fetch": "node scripts/download-ffmpeg.mjs",
    "testbilder": "node scripts/testbilder.mjs",
    "package": "npm run exiftool:fetch && npm run ffmpeg:fetch && npm run build && npx --yes electron-builder@26.17.0 --publish never",
    "package:dir": "npm run exiftool:fetch && npm run ffmpeg:fetch && npm run build && npx --yes electron-builder@26.17.0 --dir --publish never",
    "abnahme:sandbox": "node scripts/sandbox-abnahme.mjs --starten"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "clsx": "2.1.1",
    "electron": "44.8.0",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "lucide-react": "0.577.0",
    "playwright-core": "1.64.0",
    "postcss": "8.5.29",
    "prettier": "3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "zustand": "5.0.15"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "sharp": "0.35.5"
  }
}
