# Übernommen aus der Mottulbox (project_mega/.npmrc). Sicherheit und Reproduzierbarkeit,
# siehe docs/SICHERHEIT.md („Lieferkette“).
engine-strict=true
# Neu hinzugefügte Pakete exakt pinnen (keine ungewollten Caret-Sprünge)
save-exact=true
fund=false
# Keine Install-Skripte von Abhängigkeiten (häufigster Angriffsweg). Die Electron-Binary holt
# scripts/fetch-electron-bin.mjs (in dev, start und e2e eingebaut); sharp und better-sqlite3
# bringen fertige Binaries mit. Folge: npm führt auch keine pre-/post-Skripte aus –
# package.json hat deshalb keine.
ignore-scripts=true
